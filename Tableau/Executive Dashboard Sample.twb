      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1eex1um064xkp510e386g0xvvtgy].[usr:Calculation_4512423339610116:qk]&quot;' value='Margin' />
        </aliases>
      </column>
      <column caption='Business Result Value (copy)' datatype='real' name='[Business Result Value (copy)_4512423334273027]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Pivot Field Values]' />
      </column>
      <column caption='Dynamic Sales Format' datatype='string' name='[Calculation_4292795727990786]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4512423350812679] &gt;= 1000000000000 THEN&#10;    STR(ROUND([Calculation_4512423350812679] / 1000000000000, 1)) + &quot;T&quot;&#10;ELSEIF [Calculation_4512423350812679] &gt;= 1000000000 THEN&#10;    STR(ROUND([Calculation_4512423350812679] / 1000000000, 1)) + &quot;B&quot;&#10;ELSEIF [Calculation_4512423350812679] &gt;= 1000000 THEN &#10;    STR(ROUND([Calculation_4512423350812679] / 1000000, 1)) + &quot;M&quot;&#10;ELSEIF [Calculation_4512423350812679] &gt;= 1000 THEN &#10;    STR(ROUND([Calculation_4512423350812679] / 1000, 1)) + &quot;K&quot;&#10;ELSE &#10;    STR(ROUND([Calculation_4512423350812679], 0))&#10;END' />
      </column>
      <column caption='Year' datatype='integer' name='[Calculation_4292795740917764]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='YEAR([Order Date])' />
      </column>
      <column caption='Month' datatype='string' name='[Calculation_4512423321534464]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [Order Date])' />
        <aliases>
          <alias key='&quot;April&quot;' value='Apr' />
          <alias key='&quot;August&quot;' value='Aug' />
          <alias key='&quot;December&quot;' value='Dec' />
          <alias key='&quot;February&quot;' value='Feb' />
          <alias key='&quot;January&quot;' value='Jan' />
          <alias key='&quot;July&quot;' value='Jul' />
          <alias key='&quot;June&quot;' value='Jun' />
          <alias key='&quot;March&quot;' value='Mar' />
          <alias key='&quot;November&quot;' value='Nov' />
          <alias key='&quot;October&quot;' value='Oct' />
          <alias key='&quot;September&quot;' value='Sep' />
        </aliases>
      </column>
      <column caption='SPACE' datatype='real' name='[Calculation_4512423331594241]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0.2' />
      </column>
      <column caption='X-axis' datatype='real' name='[Calculation_4512423331631106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE ATTR([Pivot Field Names])&#10;    WHEN &apos;Sales&apos; THEN INDEX() - [Calculation_4512423331594241]&#10;    WHEN &apos;Profit&apos; THEN INDEX() + [Calculation_4512423331594241]&#10;ELSE INDEX()&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total Profit Margin' datatype='real' name='[Calculation_4512423339610116]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4512423350444038]) / SUM([Calculation_4512423350812679])' />
      </column>
      <column caption='Profit' datatype='real' name='[Calculation_4512423350444038]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Pivot Field Names] = &apos;Profit&apos; THEN [Pivot Field Values] END' />
      </column>
      <column caption='Sales' datatype='real' name='[Calculation_4512423350812679]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Pivot Field Names] = &apos;Sales&apos; THEN [Pivot Field Values] END' />
      </column>
      <column caption='X-axis Labels' datatype='string' name='[Calculation_4673158309183488]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4512423331631106] = 1 THEN &quot;Jan&quot;&#10;ELSEIF [Calculation_4512423331631106] = 2 THEN &quot;Feb&quot;&#10;ELSEIF [Calculation_4512423331631106] = 3 THEN &quot;Mar&quot;&#10;ELSEIF [Calculation_4512423331631106] = 4 THEN &quot;Apr&quot;&#10;ELSEIF [Calculation_4512423331631106] = 5 THEN &quot;May&quot;&#10;ELSEIF [Calculation_4512423331631106] = 6 THEN &quot;Jun&quot;&#10;ELSEIF [Calculation_4512423331631106] = 7 THEN &quot;Jul&quot;&#10;ELSEIF [Calculation_4512423331631106] = 8 THEN &quot;Aug&quot;&#10;ELSEIF [Calculation_4512423331631106] = 9 THEN &quot;Sep&quot;&#10;ELSEIF [Calculation_4512423331631106] = 10 THEN &quot;Oct&quot;&#10;ELSEIF [Calculation_4512423331631106] = 11 THEN &quot;Nov&quot;&#10;ELSEIF [Calculation_4512423331631106] = 12 THEN &quot;Dec&quot;&#10;ELSE &quot;Check Labels&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Column Index' datatype='integer' name='[Calculation_4673158329663490]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(INDEX()-1) % 4'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Row Index' datatype='integer' name='[Calculation_4673158329917443]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT((INDEX()-1) / 4)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Blank' datatype='string' name='[Calculation_4673158339219461]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
